    "strict": true,
    "target": "esnext",
    "moduleResolution": "bundler",
    "allowJs": false,
    "jsx": "react-native",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["App.tsx", "lib/mobile-trpc.ts"],
